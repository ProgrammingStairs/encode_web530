<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <center><h2>Express Validator</h2></center>
    <hr width="300">
        <center>
            <a href="/">Home</a>    |   
            <a href="/register">Register</a>  
        </center>
    <hr width="300">
    <blockquote>
        <center>
        <h2>Register</h2>
        <form action="/viewInfo" method="post">
            <input
                type="text"
                placeholder="Enter Username"
                id="username"
                name="username"
                required
            > <br>
            <input
                type="email"
                placeholder="Enter Email"
                id="email"
                name="email"
                required
            > <br>
            <input
                type="password"
                placeholder="Enter Password"
                id="password"
                name="password"
                required
            > <br>
            <input
                type="text"
                placeholder="Enter 10 digit contact No."
                id="contact"
                name="contact"
                required
            > <br>
            <input
                type="submit"
                value="Register"
            >
            <input
                type="reset"
                value="Reset"
            > <br>
            
        </form>
        </center>
    </blockquote>
</body>
</html>