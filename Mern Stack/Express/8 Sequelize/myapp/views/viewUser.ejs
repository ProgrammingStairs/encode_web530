<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body> 
    <%- include('./header.ejs') %>
    <blockquote>
        <center>
            <h2>View User</h2>
            <% if(dataArray.length == 0){%>
                No Record Found
            <%}else{%>
            <table border="1" cellspacing="0" cellpadding="8">
                <tr>
                    <th>S.No</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Address</th>
                </tr>
                <% dataArray.forEach((user,index)=>{%>
                    <tr>
                        <td><%= index+1 %></td>
                        <td><%=user.username%></td>
                        <td><%=user.email%></td>
                        <td><%=user.address%></td>
                    </tr>
                <%}) %>
            </table>
            <%}%>
        </center>
    </blockquote>
</body>
</html>