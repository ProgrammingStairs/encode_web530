<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <center>
        <h2>Router Level Middelware | Express with MySQL</h2>
        <hr width="400">
            <a href="/admin/">Home</a>    |   
            <a href="/admin/userList">UserList</a>    |   
            <a href="/admin/logout">Logout</a>
        <hr width="400">
    </center>
    <blockquote>
        <h3>Admin User List | <%=email%></h3>
        <% if(result.length==0){%>
            <h3>No Record Found</h3> 
        <%}else{%>
        <table border="1" cellspacing="0" cellpadding="8">
            <tr>
                <th>S.No</th>
                <th>Username</th>
                <th>Email</th>
                <th>password</th>
                <th>Address</th>
            </tr>
            <% result.forEach((obj,index)=>{%>
                    <tr>
                        <td><%= index+1 %></td>
                        <td><%= obj.username %></td>
                        <td><%= obj.email %></td>
                        <td><%= obj.password %></td>
                        <td><%= obj.address %></td>
                    </tr>
            <%}) %>
        </table>
        <%}%>
    </blockquote>
</body>
</html>